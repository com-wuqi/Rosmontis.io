DRIVER=~fastapi+~httpx+~websockets
# 驱动器类型, 不建议修改
SENTRY_DSN=
# 必填, 自行前往 https://sentry.io/ 注册, 选择 python 项目即可获得
SENTRY_SEND_DEFAULT_PII=True
# SENTRY相关, 不建议修改
LOCALSTORE_USE_CWD=true
SQLALCHEMY_DATABASE_URL=mysql+aiomysql://root:test@localhost:3306/data
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_PASSWORD=your_secure_bot_password
DOCKER_QQ_ACCOUNT=
# 容器部署时候 需要提供qq号 , 其他情况可以为空
# 数据库选项, 根据自己的酌情修改
# IMAGE=
# 使用构建产物进行docker部署时的镜像地址, 为空即使用默认值
ONEBOT_WS_URLS=["ws://127.0.0.1:3001/"]
# ws服务器的地址, 根据提供方修改, 要求 onebotv11
ONEBOT_ACCESS_TOKEN=test
# ws token, 根据提供方修改, 注意检查下面的snowlumaAPI__UPLOAD_WS_TOKEN字段
COMMAND_START=["/"]
# 命令触发的前置字符, 例如: /test , 支持配置多个
SUPERUSERS=["1001"]
# 内置配置项, 里面是超级管理员的id, 注意是字符串, 可以配置多个

# ALEMBIC相关, 和数据库版本管理有关, 不建议修改
ALEMBIC_STARTUP_CHECK=true
ALEMBIC_SCRIPT_LOCATION=migrations

AIHELPER__IS_ENABLE=true
# aihelper总开关, 如需修改api请通过命令或直接修改数据库
AIHELPER__TOOLS_MAX_ONCE_CALLS=20
# 最多单个会话调用工具次数
#AIHELPER__API_TIMEOUT=300
# 接口超时限制

SELFHOSTAIUSERS=["1002"]
# aihelper配置项, 里面的用户允许自定义ai的api接口
#AIHELPER__MAX_WORKERS=2
# 最大worker数，过多会丢弃
AIHELPER__REDIS_URL=redis://localhost:6379/0
# Redis连接地址。Docker部署时使用 redis://redis:6379/0，本地开发使用 redis://localhost:6379/0
AIHELPER__REDIS_LONG_EXPIRE_TIME=604800
# 会话数据在Redis中的过期时间（秒）。默认7天(604800)。
# 活跃会话每次对话都会刷新此TTL；ai save后的非活跃会话TTL减半。
# 超时后Redis自动清理，对话上下文需要重新 /ai load 从数据库恢复。

# AI 文件能力
AI_FILE_READER__IS_ENABLE=true
# 图片读取能力
#AI_FILE_READER__IS_ENABLE_IMAGE=true
#AI_FILE_READER__IMAGE_AI_API_URL=https://
#AI_FILE_READER__IMAGE_AI_API_KEY=sk-
#AI_FILE_READER__IMAGE_AI_MODEL_NAME=
## 每秒钟可以读取的图片数目
#AI_FILE_READER__IMAGE_AI_RATE_LIMIT=20
# microsoft/markitdown 支持
#AI_FILE_READER__IS_ENABLE_MARKITDOWN=true
#AI_FILE_READER__MARKITDOWN_RATE_LIMIT=10

# 其他配置参考 src/plugins/ai_file_reader/config.py

YAOHUD__IS_ENABLE=true
# yaohud 总开关
YAOHUD__BASE_URL=https://api.yaohud.cn
# 上游api地址, 不建议修改
YAOHUD__API_KEY=test
YAOHUD__API_SECRET=test
# 字面意思, 注意有些接口需要付费
#YAOHUD__WYVIP_COOKIE=
#YAOHUD__QQMUSIC_COOKIE=
## 暂时不用, 非会员需要, 暂未实现
YAOHUD__WYVIP_LEVEL=standard
YAOHUD__QQMUSIC_LEVEL=mp3
YAOHUD__KUWO_SIZE=standard
# 以上三项为音质, 参考 src/plugins/yaohud/config.py

PUBLICAPI__UPLOAD_WS_URL=ws://127.0.0.1:3001
PUBLICAPI__UPLOAD_WS_TOKEN=test
# 推荐: 如果你使用snowluma且不希望自己配置文件上传服务,
# 请确保PUBLICAPI__UPLOAD_WS_URL和PUBLICAPI__UPLOAD_WS_TOKEN与ONEBOT_WS_URLS,ONEBOT_ACCESS_TOKEN相同, 不需要 /onebot/v11/ws 后缀
# 文件上传服务, 如果不是 snowluma, 部署 server 目录里面的服务器实现到提供方设备上
# 如果提供方和机器人实例在同一个设备上面, 或者可以互相访问目录, 请修改PUBLICAPI__IS_ENABLE_UPLOAD为false
PUBLICAPI__IS_ENABLE_UPLOAD=true
#PUBLICAPI__GLOBAL_PROGRESS_POOL_MAX_WORKERS=2 # 最好为核心数或者核心数+1
#PUBLICAPI__GLOBAL_THREAD_POOL_MAX_WORKERS=2 # 最好为核心数或者核心数+1

APSCHEDULER_AUTOSTART=true
APSCHEDULER_CONFIG={"apscheduler.jobstores":{"default":{"type":"sqlalchemy","url":"mysql+pymysql://root:test@localhost:3306/data","tablename":"apscheduler_jobs"}}}

MCPSUPPORT__IS_ENABLE=true
# MCP 选项
AIHELPER__IS_ENABLE_TOOL_PROMPT=True
# 是否启用工具提示词, 建议启用

SELF_BUILD_TTS__IS_ENABLE=false
# tts相关, 默认禁用, 全局开关, 不推荐, 实验性
# 您需要参考 TTS_Support.md 和 src/plugins/self_build_tts/config.py 和上文 自行增加配置项目或者修改 src/plugins/self_build_tts/config.py

HOOKED_MCP___=true

#FEISHU_BOTS='
#[
#  {
#    "app_id": "<your app_id>",
#    "app_secret": "<your app_secret>",
#    "verification_token": "<your app_verification_token>",
#    "protocol": "ws"
#  },
#  {
#    "app_id": "<your app_id2>",
#    "app_secret": "<your app_secret2>",
#    "verification_token": "<your app_verification_token2>",
#    "protocol": "http"
#  }
#]
#'
## 请参考 https://feishu.adapters.nonebot.dev/docs/guide/setup